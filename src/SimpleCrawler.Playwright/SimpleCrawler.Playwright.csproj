<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Headless-browser crawling backend for SimpleCrawler using Microsoft Playwright, for fully JavaScript-rendered sites. Requires browsers via `playwright install`.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="[1.57.0,2)" />
	<PackageReference Include="Microsoft.Extensions.Logging" Version="[10.0.0,)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleCrawler.Core\SimpleCrawler.Core.csproj" />
  </ItemGroup>

</Project>
