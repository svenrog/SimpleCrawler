<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Authors>Sven-Erik Jonsson</Authors>
    <Copyright>Copyright © Sven-Erik Jonsson</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/svenrog/SimpleCrawler</PackageProjectUrl>
    <RepositoryUrl>https://github.com/svenrog/SimpleCrawler</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>crawler;web-crawler;scraper;scraping;robots-txt;sitemap;load-testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\assets\icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <!-- dotnet publish (unlike dotnet pack) never needs .pdb/.xml doc files in its output; keeps
       the CLI's publish folder to just the runtime closure. Scoped to _IsPublishing so
       IncludeSymbols/.snupkg packing and doc-file generation above are unaffected, as is
       dotnet build/F5 debugging. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <DebugType>None</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
