<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Shared JavaScript-rendering pipeline for SimpleCrawler: the pure-JS DOM prelude and renderer used by the Jint and V8 engine backends.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Rendering\Preludes\*.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="[10.0.0,)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleCrawler.Core\SimpleCrawler.Core.csproj" />
  </ItemGroup>

</Project>
