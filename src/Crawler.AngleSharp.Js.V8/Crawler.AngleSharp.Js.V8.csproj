<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- ClearScript's managed assembly and its native V8 runtime must be the exact same version,
         or the native library fails to load. JavaScriptEngineSwitcher.V8 pulls in the managed
         Microsoft.ClearScript.V8 but no native runtime, so we pin both to this single version and
         add the matching native package for the building platform below. -->
    <ClearScriptV8Version>7.5.1</ClearScriptV8Version>
    <ClearScriptOsArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</ClearScriptOsArchitecture>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JavaScriptEngineSwitcher.V8" Version="[3.34.1,4)" />
    <PackageReference Include="Microsoft.ClearScript.V8" Version="$(ClearScriptV8Version)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="$(ClearScriptV8Version)"
      Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(ClearScriptOsArchitecture)' == 'X64'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x86" Version="$(ClearScriptV8Version)"
      Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(ClearScriptOsArchitecture)' == 'X86'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-arm64" Version="$(ClearScriptV8Version)"
      Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(ClearScriptOsArchitecture)' == 'Arm64'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="$(ClearScriptV8Version)"
      Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(ClearScriptOsArchitecture)' == 'X64'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-arm64" Version="$(ClearScriptV8Version)"
      Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(ClearScriptOsArchitecture)' == 'Arm64'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-arm" Version="$(ClearScriptV8Version)"
      Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(ClearScriptOsArchitecture)' == 'Arm'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-x64" Version="$(ClearScriptV8Version)"
      Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(ClearScriptOsArchitecture)' == 'X64'" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="$(ClearScriptV8Version)"
      Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(ClearScriptOsArchitecture)' == 'Arm64'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crawler.AngleSharp.Js\Crawler.AngleSharp.Js.csproj" />
  </ItemGroup>

</Project>
