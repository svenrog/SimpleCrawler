{
  "name": "crawler.js.dom",
  "version": "0.0.1",
  "private": true,
  "description": "TypeScript frontend that compiles to the embedded dom.js prelude for the SimpleCrawler.Js backends",
  "scripts": {
    "build": "npm run build:dom && npm run build:fetch && npm run build:stream && npm run build:indexeddb",
    "build:dom": "esbuild index.ts --bundle --format=iife --platform=neutral --target=es2020 --outfile=../SimpleCrawler.Js/Rendering/Preludes/dom.js",
    "build:fetch": "esbuild ./network/index.ts --bundle --format=iife --platform=neutral --target=es2020 --outfile=../SimpleCrawler.Js/Rendering/Preludes/fetch.js",
    "build:stream": "esbuild ./stream/index.ts --bundle --format=iife --platform=neutral --target=es2020 --outfile=../SimpleCrawler.Js/Rendering/Preludes/stream.js",
    "build:indexeddb": "esbuild ./indexeddb/prelude.ts --bundle --format=iife --platform=neutral --target=es2020 --outfile=../SimpleCrawler.Js/Rendering/Preludes/indexeddb.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0"
  }
}
