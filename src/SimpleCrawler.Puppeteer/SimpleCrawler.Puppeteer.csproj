<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Headless-browser crawling backend for SimpleCrawler using PuppeteerSharp, for fully JavaScript-rendered sites. Downloads Chromium on first run.</Description>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="PuppeteerSharp" Version="[25.0.4,26)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SimpleCrawler.Core\SimpleCrawler.Core.csproj" />
	</ItemGroup>

</Project>
