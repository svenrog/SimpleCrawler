	</ItemGroup>

	<ItemGroup>
		<None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SimpleCrawler.Robots.Tests" />
		<InternalsVisibleTo Include="SimpleCrawler.Tests" />
	</ItemGroup>

</Project>
